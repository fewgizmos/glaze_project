#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64) in;

struct point
{
    vec4 pos;
    vec4 color;
};

layout(buffer_reference, std430) buffer point_buffer
{
    point data[];
};

layout(push_constant) uniform constants
{
    point_buffer points;
} pc;

const uint COUNT    = 288u;
const uint PER_PAIR = 3u;

const float RISE   = 0.03;
const float RADIUS = 0.25;
const float TWIST  = 20.944;
const float SPIN   = 0.015;
const float GROOVE = 2.4;

const vec3 STRAND_COLOR = vec3(1.00, 0.25, 0.65);

float radius_at(float y, float phase)
{
    return RADIUS * (1.0 + 0.06 * sin(y * 8.0 - phase * 2.0));
}

vec3 helix_at(float y, float phase)
{
    float angle = y * TWIST + phase + GROOVE;

    return vec3(cos(angle), 0.0, sin(angle)) * radius_at(y, phase) + vec3(0.0, y, 0.0);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= COUNT) {
        return;
    }

    uint pair = i / PER_PAIR;
    uint sub  = i % PER_PAIR;

    float half_height = 0.5 * float(COUNT / PER_PAIR) * RISE;

    float y = float(pair) * RISE - half_height + float(sub) / float(PER_PAIR) * RISE;

    float phase = pc.points.data[i].color.w + SPIN;

    pc.points.data[i].pos   = vec4(helix_at(y, phase), 1.0);
    pc.points.data[i].color = vec4(STRAND_COLOR, phase);
}
