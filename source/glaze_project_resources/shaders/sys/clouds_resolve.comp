#version 450
#extension GL_EXT_buffer_reference : require

#include "sys/util/atmosphere_params.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 6) uniform sampler2D history;

layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D output_target;
layout(set = 0, binding = 8, r32f) uniform readonly image2D depth_source;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D trace_source;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
    uint reset;
    float history_weight;
} pc;

const float KILOMETERS_TO_METERS = 1000.0;

void main()
{
    ivec2 size = imageSize(output_target);
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec4 current = imageLoad(trace_source, id);

    if (pc.reset != 0u) {
        imageStore(output_target, id, current);
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    vec2 ndc = (vec2(id) + 0.5) / vec2(size) * 2.0 - 1.0;

    vec4 near_point = params.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec4 far_point  = params.inv_view_proj * vec4(ndc, 0.0, 1.0);

    vec3 direction = normalize(far_point.xyz / far_point.w - near_point.xyz / near_point.w);

    float depth = imageLoad(depth_source, id).r * KILOMETERS_TO_METERS;

    vec4 previous_clip = params.previous_view_proj * vec4(params.camera_world_position + direction * depth, 1.0);

    if (previous_clip.w <= 0.0) {
        imageStore(output_target, id, current);
        return;
    }

    vec2 previous_uv = previous_clip.xy / previous_clip.w * 0.5 + 0.5;

    if (any(lessThan(previous_uv, vec2(0.0))) || any(greaterThan(previous_uv, vec2(1.0)))) {
        imageStore(output_target, id, current);
        return;
    }

    vec4 neighbourhood_min = current;
    vec4 neighbourhood_max = current;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec4 neighbour = imageLoad(trace_source, clamp(id + ivec2(x, y), ivec2(0), size - 1));

            neighbourhood_min = min(neighbourhood_min, neighbour);
            neighbourhood_max = max(neighbourhood_max, neighbour);
        }
    }

    vec4 previous = clamp(textureLod(history, previous_uv, 0.0), neighbourhood_min, neighbourhood_max);

    imageStore(output_target, id, mix(current, previous, pc.history_weight));
}
