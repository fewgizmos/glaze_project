#version 450
#extension GL_EXT_buffer_reference : require

#include "head/atmosphere_params.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 6) uniform sampler2D history;

layout(set = 0, binding = 7, rgba32f) uniform writeonly image2D output_target;
layout(set = 0, binding = 8, r32f) uniform readonly image2D depth_source;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D trace_source;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
    uint reset;
    float history_weight;
    uint cell;
    uint padding0;
} pc;

#include "head/clouds_checkerboard.glsl"

const float KILOMETERS_TO_METERS = 1000.0;

const float RAY_FAR_DEPTH = 0.0001;

const float CLAMP_EXPANSION = 0.15;

const int EDGE_MARGIN_CELLS = 2;

const float TRUSTED_MOTION_PIXELS = 0.5;
const float REJECTED_MOTION_PIXELS = 6.0;

vec4 fresh_sample(ivec2 cell, ivec2 offset, ivec2 size)
{
    return imageLoad(trace_source, clamp(cell * int(pc.cell) + offset, ivec2(0), size - 1));
}

vec4 interpolate_fresh(ivec2 id, ivec2 offset, ivec2 size, out vec4 neighbourhood_min, out vec4 neighbourhood_max)
{
    vec2 grid = vec2(id - offset) / float(pc.cell);

    ivec2 cell = ivec2(floor(grid));
    vec2  f    = grid - vec2(cell);

    vec4 s00 = fresh_sample(cell, offset, size);
    vec4 s10 = fresh_sample(cell + ivec2(1, 0), offset, size);
    vec4 s01 = fresh_sample(cell + ivec2(0, 1), offset, size);
    vec4 s11 = fresh_sample(cell + ivec2(1, 1), offset, size);

    neighbourhood_min = min(min(s00, s10), min(s01, s11));
    neighbourhood_max = max(max(s00, s10), max(s01, s11));

    return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
}

void main()
{
    ivec2 size = imageSize(output_target);
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    if (pc.reset != 0u) {
        imageStore(output_target, id, imageLoad(trace_source, id));
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    int cell_size = int(pc.cell);

    ivec2 offset = checkerboard_offset(pc.cell, params.frame_index);

    bool fresh = (id / cell_size) * cell_size + offset == id;

    vec4 neighbourhood_min;
    vec4 neighbourhood_max;

    vec4 spatial = interpolate_fresh(id, offset, size, neighbourhood_min, neighbourhood_max);
    vec4 current = fresh ? imageLoad(trace_source, id) : spatial;

    vec2 uv  = (vec2(id) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 near_point = params.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec4 far_point  = params.inv_view_proj * vec4(ndc, RAY_FAR_DEPTH, 1.0);

    vec3 direction = normalize(far_point.xyz / far_point.w - near_point.xyz / near_point.w);

    float depth = imageLoad(depth_source, id).r * KILOMETERS_TO_METERS;

    vec4 previous_clip = params.previous_view_proj * vec4(params.camera_world_position + direction * depth, 1.0);

    vec2 edge_margin = vec2(float(cell_size * EDGE_MARGIN_CELLS)) / vec2(size);

    vec2 previous_uv = previous_clip.w > 0.0 ? previous_clip.xy / previous_clip.w * 0.5 + 0.5 : vec2(-1.0);

    if (any(lessThan(previous_uv, edge_margin)) || any(greaterThan(previous_uv, 1.0 - edge_margin))) {
        imageStore(output_target, id, current);
        return;
    }

    float motion = length((previous_uv - uv) * vec2(size));

    float trust = 1.0 - clamp((motion - TRUSTED_MOTION_PIXELS) / (REJECTED_MOTION_PIXELS - TRUSTED_MOTION_PIXELS), 0.0, 1.0);

    vec4 extent = (neighbourhood_max - neighbourhood_min) * CLAMP_EXPANSION;

    vec4 previous = clamp(textureLod(history, previous_uv, 0.0), neighbourhood_min - extent, neighbourhood_max + extent);

    if (!fresh) {
        imageStore(output_target, id, mix(spatial, previous, trust));
        return;
    }

    imageStore(output_target, id, mix(current, previous, pc.history_weight * trust));
}
