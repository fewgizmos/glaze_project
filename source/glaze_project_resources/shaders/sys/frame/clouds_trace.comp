#version 450
#extension GL_EXT_buffer_reference : require

#include "head/atmosphere.glsl"
#include "head/noise.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 1) uniform sampler2D multi_scattering_lut;
layout(set = 0, binding = 2) uniform sampler2DArray sky_view_lut;
layout(set = 0, binding = 3) uniform sampler3D shape_noise;
layout(set = 0, binding = 4) uniform sampler3D detail_noise;
layout(set = 0, binding = 5) uniform sampler2D weather_map;

layout(set = 0, binding = 7, rgba32f) uniform writeonly image2D trace_target;
layout(set = 0, binding = 8, r32f) uniform writeonly image2D depth_target;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
    float quality;
    uint full;
} pc;

#include "head/clouds.glsl"
#include "head/clouds_checkerboard.glsl"

const float MAX_CLOUD_DISTANCE = 60.0;

const float MIN_STEPS = 64.0;
const float MAX_STEPS = 128.0;

const float MIN_STEP_SCALE = 0.5;

const uint LIGHT_STEPS        = 6u;
const uint LIGHT_DETAIL_STEPS = 2u;

const float LIGHT_STEP_FRACTION = 0.02;
const float LIGHT_STEP_GROWTH = 1.8;

const uint OCTAVES = 3u;

const float PHASE_FALLOFF        = 0.5;
const float MAX_MULTI_SCATTERING = 0.95;
const float POWDER_SCALE         = 2.0;

const float FORWARD_G      = 0.85;
const float BACKWARD_G     = -0.3;
const float FORWARD_WEIGHT = 0.7;

const float AMBIENT_BOTTOM = 0.4;
const float AMBIENT_ELEVATION = 0.5;

const float TRANSMITTANCE_CUTOFF = 0.01;

const uint AERIAL_SAMPLES = 8u;

const uint LIGHT_COUNT = 2u;

const float EMPTY_STEP_SCALE = 2.0;

const float MIN_LIGHT_CONTRIBUTION = 0.00001;
const float MIN_LIGHT_HEIGHT       = -0.3;

float henyey_greenstein(float g, float cos_theta)
{
    float g2 = g * g;

    return (1.0 - g2) / (4.0 * ATMOSPHERE_PI * pow(max(1.0 + g2 - 2.0 * g * cos_theta, 0.000001), 1.5));
}

float cloud_phase(float cos_theta, float scale)
{
    return mix(henyey_greenstein(BACKWARD_G * scale, cos_theta), henyey_greenstein(FORWARD_G * scale, cos_theta), FORWARD_WEIGHT);
}

float light_optical_depth(atmosphere_params params, vec3 position, vec3 sun_direction)
{
    float optical_depth = 0.0;

    float t  = 0.0;
    float dt = (params.cloud_top - params.cloud_bottom) * LIGHT_STEP_FRACTION;

    for (uint i = 0u; i < LIGHT_STEPS; i++) {
        vec3 sample_position = position + sun_direction * (t + 0.5 * dt);

        float height_fraction = (length(sample_position) - params.cloud_bottom) / (params.cloud_top - params.cloud_bottom);

        if (height_fraction > 1.0) {
            break;
        }

        optical_depth += cloud_density(params, sample_position, height_fraction, i < LIGHT_DETAIL_STEPS) * dt;

        t  += dt;
        dt *= LIGHT_STEP_GROWTH;
    }

    return optical_depth * CLOUD_EXTINCTION;
}

vec3 sky_ambient(atmosphere_params params, vec3 origin)
{
    vec3 ambient = sky_luminance(params, sky_view_lut, origin, vec3(0.0, 1.0, 0.0), false);

    float horizontal = sqrt(1.0 - AMBIENT_ELEVATION * AMBIENT_ELEVATION);

    ambient += sky_luminance(params, sky_view_lut, origin, vec3( horizontal, AMBIENT_ELEVATION, 0.0), false);
    ambient += sky_luminance(params, sky_view_lut, origin, vec3(-horizontal, AMBIENT_ELEVATION, 0.0), false);
    ambient += sky_luminance(params, sky_view_lut, origin, vec3(0.0, AMBIENT_ELEVATION,  horizontal), false);
    ambient += sky_luminance(params, sky_view_lut, origin, vec3(0.0, AMBIENT_ELEVATION, -horizontal), false);

    return ambient / 5.0 + params.night_sky_luminance * NIGHT_SKY_COLOR;
}

bool cloud_segment(atmosphere_params params, vec3 origin, vec3 direction, out float t0, out float t1)
{
    float radius = length(origin);

    float inner_t = ray_sphere_nearest(origin, direction, params.cloud_bottom);
    float outer_t = ray_sphere_nearest(origin, direction, params.cloud_top);

    if (radius < params.cloud_bottom) {
        if (ray_sphere_nearest(origin, direction, params.bottom_radius) >= 0.0) {
            return false;
        }

        t0 = inner_t;
        t1 = outer_t;
    } else if (radius < params.cloud_top) {
        t0 = 0.0;
        t1 = inner_t >= 0.0 ? min(inner_t, outer_t) : outer_t;
    } else {
        return false;
    }

    t1 = min(t1, MAX_CLOUD_DISTANCE);

    return t0 >= 0.0 && t1 > t0;
}

float interleaved_gradient_noise(vec2 pixel, uint frame)
{
    pixel += 5.588238 * float(frame % 64u);

    return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

void main()
{
    ivec2 size = imageSize(trace_target);
    ivec2 id   = pc.full != 0u
        ? ivec2(gl_GlobalInvocationID.xy)
        : ivec2(gl_GlobalInvocationID.xy) * CHECKERBOARD_SIZE + checkerboard_offset(pc.atmosphere.params.frame_index);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    vec2 ndc = (vec2(id) + 0.5) / vec2(size) * 2.0 - 1.0;

    vec4 near_point = params.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec4 far_point  = params.inv_view_proj * vec4(ndc, 0.0, 1.0);

    vec3 direction = normalize(far_point.xyz / far_point.w - near_point.xyz / near_point.w);
    vec3 origin    = params.camera_position;

    float t0;
    float t1;

    if (params.clouds_enabled == 0u || !cloud_segment(params, origin, direction, t0, t1)) {
        imageStore(trace_target, id, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(depth_target, id, vec4(MAX_CLOUD_DISTANCE));
        return;
    }

    float layer_thickness = params.cloud_top - params.cloud_bottom;

    float step_count = max(floor(mix(MIN_STEPS, MAX_STEPS, clamp((t1 - t0) / layer_thickness - 1.0, 0.0, 1.0)) * pc.quality), MIN_STEPS * MIN_STEP_SCALE);
    float dt         = (t1 - t0) / step_count;

    float offset = interleaved_gradient_noise(vec2(id), params.frame_index);

    vec3 light_directions[LIGHT_COUNT] = vec3[](params.sun_direction, params.moon_direction);

    vec3 light_illuminances[LIGHT_COUNT] = vec3[](
        vec3(params.sun_illuminance) * params.cloud_luminance_scale,
        moon_illuminance_color(params) * params.cloud_luminance_scale
    );

    bool light_active[LIGHT_COUNT];

    float phases[LIGHT_COUNT][OCTAVES];
    float powder_weights[LIGHT_COUNT];

    float scattering_falloff = clamp(params.cloud_multi_scattering, 0.0, MAX_MULTI_SCATTERING);
    float extinction_falloff = 1.0 - scattering_falloff;

    for (uint l = 0u; l < LIGHT_COUNT; l++) {
        light_active[l] = max(light_illuminances[l].r, max(light_illuminances[l].g, light_illuminances[l].b)) > MIN_LIGHT_CONTRIBUTION
            && light_directions[l].y > MIN_LIGHT_HEIGHT;

        float cos_theta = dot(direction, light_directions[l]);

        powder_weights[l] = params.cloud_powder * (0.5 - 0.5 * cos_theta);

        for (uint n = 0u; n < OCTAVES; n++) {
            phases[l][n] = cloud_phase(cos_theta, pow(PHASE_FALLOFF, float(n)));
        }
    }

    vec3 ambient = sky_ambient(params, origin) * params.cloud_luminance_scale;

    vec3 luminance     = vec3(0.0);
    float transmittance = 1.0;
    float depth_sum     = 0.0;

    float next_t = t0 + offset * dt;

    for (float i = 0.0; i < step_count && next_t < t1; i += 1.0) {
        float t = next_t;

        vec3 position = origin + direction * t;

        float radius          = length(position);
        float height_fraction = (radius - params.cloud_bottom) / layer_thickness;

        vec3 sample_position;
        float shaped_height;

        float base = cloud_base(params, position, height_fraction, sample_position, shaped_height);

        if (base <= MIN_DENSITY) {
            next_t = t + dt * EMPTY_STEP_SCALE;
            continue;
        }

        next_t = t + dt;

        float density = cloud_erode(params, base, sample_position, shaped_height, height_fraction);

        if (density <= MIN_DENSITY) {
            continue;
        }

        float extinction = density * CLOUD_EXTINCTION;

        vec3 up = position / radius;

        vec3 source = ambient * mix(AMBIENT_BOTTOM, 1.0, clamp(height_fraction, 0.0, 1.0));

        for (uint l = 0u; l < LIGHT_COUNT; l++) {
            if (!light_active[l]) {
                continue;
            }

            vec3 light_direction = light_directions[l];

            if (ray_sphere_nearest(position, light_direction, params.bottom_radius) >= 0.0) {
                continue;
            }

            vec3 light_transmittance = sample_transmittance(params, transmittance_lut, radius, dot(light_direction, up));

            float optical_depth = light_optical_depth(params, position, light_direction);

            float scattering = 0.0;

            for (uint n = 0u; n < OCTAVES; n++) {
                scattering += pow(scattering_falloff, float(n)) * phases[l][n] * exp(-optical_depth * pow(extinction_falloff, float(n)));
            }

            float powder = mix(1.0, 1.0 - exp(-POWDER_SCALE * density), powder_weights[l]);

            source += light_illuminances[l] * light_transmittance * scattering * powder;
        }

        float step_transmittance = exp(-extinction * dt);
        float step_opacity       = transmittance * (1.0 - step_transmittance);

        luminance += source * step_opacity;
        depth_sum += t * step_opacity;

        transmittance *= step_transmittance;

        if (transmittance < TRANSMITTANCE_CUTOFF) {
            transmittance = 0.0;
            break;
        }
    }

    float opacity = 1.0 - transmittance;

    float depth = opacity > MIN_DENSITY ? depth_sum / opacity : MAX_CLOUD_DISTANCE;

    vec3 segment_transmittance = vec3(1.0);
    vec3 inscatter             = vec3(0.0);

    for (uint l = 0u; l < LIGHT_COUNT; l++) {
        if (!light_active[l]) {
            continue;
        }

        vec3 light_segment_transmittance;

        inscatter += light_illuminances[l] * integrate_luminance(
            params,
            transmittance_lut,
            multi_scattering_lut,
            origin,
            direction,
            light_directions[l],
            depth,
            AERIAL_SAMPLES,
            true,
            false,
            light_segment_transmittance
        );

        segment_transmittance = light_segment_transmittance;
    }

    vec3 result = luminance * segment_transmittance + inscatter * opacity;

    imageStore(trace_target, id, vec4(result, transmittance));
    imageStore(depth_target, id, vec4(depth));
}
