#version 450
#extension GL_EXT_buffer_reference : require

#include "head/scene_types.glsl"
#include "head/height_fog.glsl"
#include "head/vsm.glsl"
#include "head/cloud_shadow.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler3D history;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image3D current;
layout(set = 0, binding = 2) uniform sampler2DArray cloud_shadow_map;
layout(set = 0, binding = 3) uniform sampler2D shadow_pool;

layout(push_constant) uniform constants
{
    frame_buffer frame;
    fog_params_buffer fog;
} pc;

const uint  FOG_SHADOW_LEVEL_BIAS     = 3u;
const uint  FOG_SHADOW_FALLBACK       = 3u;
const float FOG_SHADOW_BIAS_TEXELS    = 2.0;
const float RAY_FAR_DEPTH             = 0.0001;
const float SHADOWED_LIGHT_ALIGNMENT  = 0.999;

float vsm_visibility(vec3 world_pos, float distance)
{
    vsm_params_buffer params = pc.frame.shadows;

    vec3 light_pos = vsm_light_space(params, world_pos);

    uint level = min(vsm_select_level(params, distance, light_pos.xy) + FOG_SHADOW_LEVEL_BIAS, VSM_LEVELS - 1u);

    ivec2 page;
    vec2  in_page;

    if (vsm_window_page(params, level, light_pos.xy, page, in_page)) {
        uint slot = vsm_slot(level, page);

        if ((params.entries.data[slot].state & VSM_STATE_REQUESTED) == 0u) {
            atomicOr(params.entries.data[slot].state, VSM_STATE_REQUESTED);
        }
    }

    for (uint i = 0u; i < FOG_SHADOW_FALLBACK && level + i < VSM_LEVELS; i++) {
        ivec2 texel;
        uint  state;

        if (vsm_find_texel(params, level + i, light_pos.xy, texel, state)) {
            float depth = vsm_depth_to_light(params, level + i, texelFetch(shadow_pool, texel, 0).r);

            return depth >= light_pos.z - vsm_texel_size(params, level + i) * FOG_SHADOW_BIAS_TEXELS ? 1.0 : 0.0;
        }
    }

    return 1.0;
}

float light_visibility(atmosphere_params atmosphere, vec3 world_pos, vec3 to_light, uint layer, float distance)
{
    float visibility = 1.0;

    if (atmosphere.clouds_enabled != 0u) {
        vec2 uv = cloud_shadow_uv(atmosphere.camera_world_position, world_pos);

        if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)))) {
            visibility *= textureLod(cloud_shadow_map, vec3(uv, float(layer)), 0.0).r;
        }
    }

    if (visibility > 0.0 && pc.frame.has_shadows != 0u && dot(-pc.frame.shadows.light_z.xyz, to_light) > SHADOWED_LIGHT_ALIGNMENT) {
        visibility *= vsm_visibility(world_pos, distance);
    }

    return visibility;
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(uvec3(id), FOG_GRID))) {
        return;
    }

    if (pc.frame.has_atmosphere == 0u) {
        imageStore(current, id, vec4(0.0));
        return;
    }

    atmosphere_params atmosphere = pc.frame.atmosphere.params;

    vec2 ndc = (vec2(id.xy) + 0.5) / vec2(FOG_GRID.xy) * 2.0 - 1.0;

    vec4 near_point = pc.fog.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec4 far_point  = pc.fog.inv_view_proj * vec4(ndc, RAY_FAR_DEPTH, 1.0);

    vec3 direction = normalize(far_point.xyz / far_point.w - near_point.xyz / near_point.w);

    float distance = fog_slice_distance(pc.fog, float(id.z) + pc.fog.jitter);

    vec3 world_pos = pc.fog.camera_pos + direction * distance;

    bool has_history = false;
    vec4 history_value = vec4(0.0);

    if (pc.fog.reset == 0u) {
        vec4 previous_clip = pc.fog.previous_view_proj * vec4(world_pos, 1.0);

        if (previous_clip.w > 0.0) {
            vec3 coord = vec3(
                previous_clip.xy / previous_clip.w * 0.5 + 0.5,
                fog_distance_slice(pc.fog, length(world_pos - pc.fog.previous_camera_pos)) / float(FOG_GRID.z)
            );

            if (all(greaterThanEqual(coord, vec3(0.0))) && all(lessThanEqual(coord, vec3(1.0)))) {
                has_history   = true;
                history_value = textureLod(history, coord, 0.0);
            }
        }
    }

    if (has_history && uint(id.x + id.y + id.z) % 2u != pc.fog.parity) {
        imageStore(current, id, history_value);
        return;
    }

    float density = atmosphere.fog_density * exp(-atmosphere.fog_height_falloff * (world_pos.y - atmosphere.fog_base_height));

    vec3 ambient = pc.frame.environment_sh.coefficients[0].rgb * FOG_SH_BAND0 * pc.frame.environment_intensity;

    vec3 light = ambient
        + atmosphere.fog_sun_illuminance * fog_phase(atmosphere.fog_anisotropy, dot(direction, atmosphere.sun_direction))
            * light_visibility(atmosphere, world_pos, atmosphere.sun_direction, CLOUD_SHADOW_SUN, distance)
        + atmosphere.fog_moon_illuminance * fog_phase(atmosphere.fog_anisotropy, dot(direction, atmosphere.moon_direction))
            * light_visibility(atmosphere, world_pos, atmosphere.moon_direction, CLOUD_SHADOW_MOON, distance);

    vec4 value = vec4(light * atmosphere.fog_color * density, density);

    if (has_history) {
        value = mix(value, history_value, pc.fog.history_weight);
    }

    imageStore(current, id, value);
}
