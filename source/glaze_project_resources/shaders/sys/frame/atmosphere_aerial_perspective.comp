#version 450
#extension GL_EXT_buffer_reference : require

#include "head/atmosphere.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 1) uniform sampler2D multi_scattering_lut;
layout(set = 0, binding = 3, rgba32f) uniform writeonly image3D target;
layout(set = 0, binding = 5, rgba32f) uniform writeonly image3D moon_target;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
} pc;

const uint MIN_SAMPLE_COUNT = 2u;

void main()
{
    ivec3 size = imageSize(target);
    ivec3 id   = ivec3(gl_GlobalInvocationID);

    if (id.x >= size.x || id.y >= size.y || id.z >= size.z) {
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    vec2 ndc = (vec2(id.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;

    vec4 near_point = params.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec4 far_point  = params.inv_view_proj * vec4(ndc, 0.0, 1.0);

    vec3 direction = normalize(far_point.xyz / far_point.w - near_point.xyz / near_point.w);

    float distance = (float(id.z) + 0.5) / float(size.z) * params.aerial_max_distance;

    uint sample_count = max(MIN_SAMPLE_COUNT, uint(id.z) + 1u);

    vec3 transmittance;

    vec3 sun_luminance = integrate_luminance(
        params,
        transmittance_lut,
        multi_scattering_lut,
        params.camera_position,
        direction,
        params.sun_direction,
        distance,
        sample_count,
        true,
        false,
        transmittance
    );

    vec3 moon_transmittance;

    vec3 moon_luminance = integrate_luminance(
        params,
        transmittance_lut,
        multi_scattering_lut,
        params.camera_position,
        direction,
        params.moon_direction,
        distance,
        sample_count,
        true,
        false,
        moon_transmittance
    );

    imageStore(target, id, vec4(sun_luminance, dot(transmittance, vec3(1.0 / 3.0))));
    imageStore(moon_target, id, vec4(moon_luminance, 1.0));
}
