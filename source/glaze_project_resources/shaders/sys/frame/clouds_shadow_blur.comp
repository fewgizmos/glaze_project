#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray shadow_source;
layout(set = 0, binding = 1, r16f) uniform writeonly image2DArray shadow_target;

const float BLUR_RADIUS = 3.0;
const int   BLUR_SAMPLES = 9;

void main()
{
    ivec3 id   = ivec3(gl_GlobalInvocationID.xy, gl_WorkGroupID.z);
    ivec2 size = imageSize(shadow_target).xy;

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(id.xy) + 0.5) / vec2(size);
    vec2 texel = 1.0 / vec2(size);

    float result = 0.0;
    float weight_sum = 0.0;

    for (int dx = -1; dx <= 1; dx++) {
        for (int dy = -1; dy <= 1; dy++) {
            vec2 sample_uv = uv + vec2(dx, dy) * texel * BLUR_RADIUS;

            float distance = length(vec2(dx, dy));
            float weight = exp(-(distance * distance) / (2.0 * 0.7 * 0.7));

            result += textureLod(shadow_source, vec3(sample_uv, float(id.z)), 0.0).r * weight;
            weight_sum += weight;
        }
    }

    result /= weight_sum;

    imageStore(shadow_target, id, vec4(result));
}
