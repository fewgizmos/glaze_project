#version 450
#extension GL_EXT_buffer_reference : require

#include "head/vsm_types.glsl"
#include "head/vsm.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene_depth;

layout(push_constant) uniform constants
{
    vsm_params_buffer params;
} pc;

const uint BLOCK_SIZE    = 2u;
const uint CORNER_COUNT  = 4u;
const uint RECENT_COUNT  = 4u;

const vec2 CORNERS[CORNER_COUNT] = vec2[](
    vec2(-1.0, -1.0),
    vec2( 1.0, -1.0),
    vec2(-1.0,  1.0),
    vec2( 1.0,  1.0)
);

uint recent_slots[RECENT_COUNT];
uint recent_cursor = 0u;

bool was_requested(uint slot)
{
    for (uint i = 0u; i < RECENT_COUNT; i++) {
        if (recent_slots[i] == slot) {
            return true;
        }
    }

    recent_slots[recent_cursor] = slot;
    recent_cursor               = (recent_cursor + 1u) % RECENT_COUNT;

    return false;
}

void request_page(uint level, vec2 light_xy)
{
    ivec2 page;
    vec2  in_page;

    if (!vsm_window_page(pc.params, level, light_xy, page, in_page)) {
        return;
    }

    uint slot = vsm_slot(level, page);

    if (was_requested(slot)) {
        return;
    }

    if ((pc.params.entries.data[slot].state & VSM_STATE_REQUESTED) == 0u) {
        atomicOr(pc.params.entries.data[slot].state, VSM_STATE_REQUESTED);
    }
}

void mark_pixel(ivec2 id, ivec2 size)
{
    if (any(greaterThanEqual(id, size))) {
        return;
    }

    float depth = texelFetch(scene_depth, id, 0).r;

    if (depth <= 0.0) {
        return;
    }

    vec2 ndc = (vec2(id) + 0.5) / vec2(size) * 2.0 - 1.0;

    vec4 world = pc.params.inv_view_proj * vec4(ndc, depth, 1.0);

    vec3 world_pos = world.xyz / world.w;

    vec3 light_pos = vsm_light_space(pc.params, world_pos);

    uint level = vsm_select_level(pc.params, length(world_pos - pc.params.camera_pos), light_pos.xy);

    float radius = vsm_search_radius(pc.params, level) + vsm_texel_size(pc.params, level) * pc.params.normal_bias;

    for (uint i = 0u; i < CORNER_COUNT; i++) {
        request_page(level, light_pos.xy + CORNERS[i] * radius);
    }
}

void main()
{
    for (uint i = 0u; i < RECENT_COUNT; i++) {
        recent_slots[i] = VSM_NO_PAGE;
    }

    ivec2 size  = textureSize(scene_depth, 0);
    ivec2 block = ivec2(gl_GlobalInvocationID.xy) * int(BLOCK_SIZE);

    for (uint y = 0u; y < BLOCK_SIZE; y++) {
        for (uint x = 0u; x < BLOCK_SIZE; x++) {
            mark_pixel(block + ivec2(x, y), size);
        }
    }
}
