#version 450
#extension GL_EXT_buffer_reference : require

#include "head/scene_types.glsl"
#include "head/vsm.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene_depth;

layout(set = 0, binding = 1, r16f) uniform image2D mask_target;

layout(set = 0, binding = 2) uniform sampler2D shadow_pool;

layout(push_constant) uniform constants
{
    frame_buffer frame;
    uint accumulated_frames;
    uint padding0;
} pc;

const float PI = 3.14159265359;

const uint SHADOW_SAMPLES     = 8u;
const uint MIN_SHADOW_SAMPLES = 4u;

const uint  SHADOW_FALLBACK_LEVELS   = 3u;
const float SHADOW_DEPTH_BIAS_TEXELS = 1.0;
const float SHADOW_DEPTH_ULPS        = 4.0;

const uint CONTACT_STEPS     = 8u;
const uint MIN_CONTACT_STEPS = 4u;
const uint MIN_SCREEN_STEPS  = 2u;

const float THICKNESS_BASE     = 0.03;
const float THICKNESS_DISTANCE = 0.004;
const float BIAS_DISTANCE      = 0.0005;
const float SLOPE_BIAS_SCALE   = 1.5;
const float MIN_SCREEN_TRAVEL  = 1.5;

const float GOLDEN_ANGLE       = 2.39996323;
const vec3  NOISE_MAGIC        = vec3(0.06711056, 0.00583715, 52.9829189);
const float NOISE_FRAME_OFFSET = 5.588238;
const uint  NOISE_FRAME_PERIOD = 64u;

const float NO_NEIGHBOUR = 1e6;

bool  cache_valid    = false;
bool  cache_present  = false;
ivec2 cache_relative = ivec2(0);
ivec2 cache_base     = ivec2(0);

float interleaved_noise(vec2 pixel, uint frame)
{
    pixel += NOISE_FRAME_OFFSET * float(frame % NOISE_FRAME_PERIOD);

    return fract(NOISE_MAGIC.z * fract(dot(pixel, NOISE_MAGIC.xy)));
}

vec2 vogel_disk(uint index, uint count, float rotation)
{
    float radius = sqrt((float(index) + 0.5) / float(count));
    float angle  = float(index) * GOLDEN_ANGLE + rotation;

    return radius * vec2(cos(angle), sin(angle));
}

vec3 world_from_depth(vec2 uv, float depth)
{
    vec4 world = pc.frame.inv_view_proj * vec4(uv * 2.0 - 1.0, depth, 1.0);

    return world.xyz / world.w;
}

float view_distance(vec3 world_pos)
{
    return -(pc.frame.view * vec4(world_pos, 1.0)).z;
}

bool world_at(ivec2 pixel, ivec2 size, out vec3 world_pos)
{
    world_pos = vec3(0.0);

    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, size))) {
        return false;
    }

    float depth = texelFetch(scene_depth, pixel, 0).r;

    if (depth <= 0.0) {
        return false;
    }

    world_pos = world_from_depth((vec2(pixel) + 0.5) / vec2(size), depth);

    return true;
}

vec3 nearest_edge(vec3 center, bool has_before, vec3 before, bool has_after, vec3 after, out bool found)
{
    float before_gap = has_before ? abs(view_distance(before) - view_distance(center)) : NO_NEIGHBOUR;
    float after_gap  = has_after ? abs(view_distance(after) - view_distance(center)) : NO_NEIGHBOUR;

    found = has_before || has_after;

    return after_gap < before_gap ? after - center : center - before;
}

vec3 geometric_normal(ivec2 id, ivec2 size, vec3 center, vec3 to_light)
{
    vec3 left;
    vec3 right;
    vec3 down;
    vec3 up;

    bool has_left  = world_at(id + ivec2(-1, 0), size, left);
    bool has_right = world_at(id + ivec2( 1, 0), size, right);
    bool has_down  = world_at(id + ivec2( 0,-1), size, down);
    bool has_up    = world_at(id + ivec2( 0, 1), size, up);

    bool found_x;
    bool found_y;

    vec3 edge_x = nearest_edge(center, has_left, left, has_right, right, found_x);
    vec3 edge_y = nearest_edge(center, has_down, down, has_up, up, found_y);

    vec3 normal = cross(edge_x, edge_y);

    if (!found_x || !found_y || dot(normal, normal) <= 0.0) {
        return to_light;
    }

    normal = normalize(normal);

    return dot(normal, pc.frame.camera_pos - center) >= 0.0 ? normal : -normal;
}

float shadow_bias_texel(vsm_params_buffer params, uint level)
{
    float quantum = SHADOW_DEPTH_ULPS * exp2(-24.0) / params.levels[level].depth_scale;

    return max(vsm_texel_size(params, level), quantum);
}

bool cached_texel(vsm_params_buffer params, uint level, vec2 light_xy, out ivec2 texel)
{
    texel = ivec2(0);

    vec2  coord    = vsm_window_coord(params, level, light_xy);
    ivec2 relative = ivec2(floor(coord));

    if (!cache_valid || relative != cache_relative) {
        cache_valid    = true;
        cache_present  = false;
        cache_relative = relative;

        if (all(greaterThanEqual(relative, ivec2(0))) && all(lessThan(relative, ivec2(VSM_LEVEL_PAGES)))) {
            ivec2 page = params.levels[level].origin + relative;

            vsm_entry entry = params.entries.data[vsm_slot(level, page)];

            if (entry.tag_x == page.x && entry.tag_y == page.y && entry.physical != VSM_NO_PAGE) {
                cache_present = true;
                cache_base    = ivec2(entry.physical % VSM_POOL_PAGES, entry.physical / VSM_POOL_PAGES) * int(VSM_PAGE_SIZE);
            }
        }
    }

    if (!cache_present) {
        return false;
    }

    texel = cache_base + min(ivec2((coord - vec2(relative)) * float(VSM_PAGE_SIZE)), ivec2(VSM_PAGE_SIZE - 1u));

    return true;
}

bool shadow_depth(vsm_params_buffer params, uint level, vec2 light_xy, float base_bias, out float depth)
{
    depth = 0.0;

    ivec2 texel;

    if (cached_texel(params, level, light_xy, texel)) {
        depth = vsm_depth_to_light(params, level, texelFetch(shadow_pool, texel, 0).r);

        return true;
    }

    for (uint i = 1u; i < SHADOW_FALLBACK_LEVELS && level + i < VSM_LEVELS; i++) {
        uint state;

        if (vsm_find_texel(params, level + i, light_xy, texel, state)) {
            depth  = vsm_depth_to_light(params, level + i, texelFetch(shadow_pool, texel, 0).r);
            depth += max(0.0, shadow_bias_texel(params, level + i) * SHADOW_DEPTH_BIAS_TEXELS - base_bias);

            return true;
        }
    }

    return false;
}

float directional_shadow(ivec2 id, vec3 world_pos, vec3 normal, vec3 to_light)
{
    vsm_params_buffer params = pc.frame.shadows;

    float distance = length(world_pos - pc.frame.camera_pos);

    uint  level      = vsm_select_level(params, distance, vsm_light_space(params, world_pos).xy);
    float texel      = vsm_texel_size(params, level);
    float bias_texel = shadow_bias_texel(params, level);

    vec3 offset_normal = dot(normal, to_light) >= 0.0 ? normal : -normal;

    vec3 light_pos = vsm_light_space(params, world_pos + offset_normal * bias_texel * params.normal_bias);

    float base_bias = bias_texel * SHADOW_DEPTH_BIAS_TEXELS;
    float receiver  = light_pos.z - base_bias;
    float radius    = vsm_search_radius(params, level);
    float rotation  = interleaved_noise(vec2(id), pc.frame.frame_index) * 2.0 * PI;

    uint samples = max(MIN_SHADOW_SAMPLES, uint(float(SHADOW_SAMPLES) * pc.frame.quality + 0.5));

    float blocker_sum   = 0.0;
    float blocker_count = 0.0;

    for (uint i = 0u; i < samples; i++) {
        float depth;

        if (shadow_depth(params, level, light_pos.xy + vogel_disk(i, samples, rotation) * radius, base_bias, depth) && depth < receiver) {
            blocker_sum   += depth;
            blocker_count += 1.0;
        }
    }

    if (blocker_count == 0.0) {
        return 1.0;
    }

    if (blocker_count >= float(samples)) {
        return 0.0;
    }

    float penumbra = (receiver - blocker_sum / blocker_count) * params.tan_angular_radius * params.softness;
    float kernel   = clamp(penumbra, texel, radius);

    float lit = 0.0;

    for (uint i = 0u; i < samples; i++) {
        float depth;

        if (!shadow_depth(params, level, light_pos.xy + vogel_disk(i, samples, rotation + PI) * kernel, base_bias, depth) || depth >= receiver) {
            lit += 1.0;
        }
    }

    return lit / float(samples);
}

float depth_slope(ivec2 id, ivec2 size, float center)
{
    vec3 left;
    vec3 right;
    vec3 down;
    vec3 up;

    float l = world_at(id + ivec2(-1, 0), size, left)  ? view_distance(left)  : -1.0;
    float r = world_at(id + ivec2( 1, 0), size, right) ? view_distance(right) : -1.0;
    float d = world_at(id + ivec2( 0,-1), size, down)  ? view_distance(down)  : -1.0;
    float u = world_at(id + ivec2( 0, 1), size, up)    ? view_distance(up)    : -1.0;

    float dx = min(l < 0.0 ? NO_NEIGHBOUR : abs(center - l), r < 0.0 ? NO_NEIGHBOUR : abs(r - center));
    float dy = min(d < 0.0 ? NO_NEIGHBOUR : abs(center - d), u < 0.0 ? NO_NEIGHBOUR : abs(u - center));

    return max(dx, dy) < NO_NEIGHBOUR ? max(dx, dy) : 0.0;
}

float contact_shadow(ivec2 id, ivec2 size, vec3 world_pos, vec3 to_light)
{
    vsm_params_buffer params = pc.frame.shadows;

    if (params.contact_length <= 0.0) {
        return 1.0;
    }

    uint max_steps = max(MIN_CONTACT_STEPS, uint(float(CONTACT_STEPS) * pc.frame.quality + 0.5));

    vec3 full_ray = to_light * params.contact_length;

    float travel_px = float(max_steps);

    vec4 end_clip = pc.frame.view_proj * vec4(world_pos + full_ray, 1.0);

    if (end_clip.w > 0.0) {
        vec2 end_px = (end_clip.xy / end_clip.w * 0.5 + 0.5) * vec2(size);

        travel_px = length(end_px - (vec2(id) + 0.5));
    }

    if (travel_px < MIN_SCREEN_TRAVEL) {
        return 1.0;
    }

    uint steps = clamp(uint(ceil(travel_px)), MIN_SCREEN_STEPS, max_steps);

    vec3 ray_step = full_ray / float(steps);

    vec3 position = world_pos + ray_step * interleaved_noise(vec2(id), pc.frame.frame_index);

    float origin_distance = view_distance(world_pos);

    float slope     = depth_slope(id, size, origin_distance);
    float thickness = THICKNESS_BASE + origin_distance * THICKNESS_DISTANCE + slope * SLOPE_BIAS_SCALE;
    float bias      = origin_distance * BIAS_DISTANCE + slope * SLOPE_BIAS_SCALE;

    for (uint i = 0u; i < steps; i++) {
        position += ray_step;

        vec4 clip = pc.frame.view_proj * vec4(position, 1.0);

        if (clip.w <= 0.0) {
            break;
        }

        vec2 uv = clip.xy / clip.w * 0.5 + 0.5;

        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
            break;
        }

        ivec2 texel = min(ivec2(uv * vec2(size)), size - 1);

        if (texel == id) {
            continue;
        }

        float scene = texelFetch(scene_depth, texel, 0).r;

        if (scene <= 0.0) {
            continue;
        }

        float delta = view_distance(position) - view_distance(world_from_depth((vec2(texel) + 0.5) / vec2(size), scene));

        if (delta > bias && delta < thickness) {
            return float(i) / float(steps);
        }
    }

    return 1.0;
}

void main()
{
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(scene_depth, 0);

    if (any(greaterThanEqual(id, size))) {
        return;
    }

    float depth = texelFetch(scene_depth, id, 0).r;

    float shadow = 1.0;

    if (depth > 0.0) {
        vec3 world_pos = world_from_depth((vec2(id) + 0.5) / vec2(size), depth);
        vec3 to_light  = -pc.frame.shadows.light_z.xyz;

        shadow = directional_shadow(id, world_pos, geometric_normal(id, size, world_pos, to_light), to_light);

        if (shadow > 0.0) {
            shadow = min(shadow, contact_shadow(id, size, world_pos, to_light));
        }
    }

    if (pc.accumulated_frames > 0u) {
        float previous = imageLoad(mask_target, id).r;

        shadow = mix(previous, shadow, 1.0 / float(pc.accumulated_frames + 1u));
    }

    imageStore(mask_target, id, vec4(shadow));
}
