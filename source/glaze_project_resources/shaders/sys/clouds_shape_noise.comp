#version 450

#include "sys/util/noise.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 7, rgba8) uniform writeonly image3D target;

const int PERLIN_FREQUENCY = 4;
const int PERLIN_OCTAVES   = 5;

const int WORLEY_FREQUENCY = 4;

void main()
{
    ivec3 size = imageSize(target);
    ivec3 id   = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(id, size))) {
        return;
    }

    vec3 uvw = (vec3(id) + 0.5) / vec3(size);

    float perlin_noise = perlin_fbm(uvw, PERLIN_FREQUENCY, PERLIN_OCTAVES);

    float worley0 = worley_fbm(uvw, WORLEY_FREQUENCY);
    float worley1 = worley_fbm(uvw, WORLEY_FREQUENCY * 2);
    float worley2 = worley_fbm(uvw, WORLEY_FREQUENCY * 4);

    float perlin_worley = clamp(remap(perlin_noise, 0.0, 1.0, worley0, 1.0), 0.0, 1.0);

    imageStore(target, id, vec4(perlin_worley, worley0, worley1, worley2));
}
