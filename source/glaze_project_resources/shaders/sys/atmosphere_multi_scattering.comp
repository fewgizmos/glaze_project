#version 450
#extension GL_EXT_buffer_reference : require

#include "sys/util/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D transmittance_lut;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
} pc;

const uint SAMPLE_COUNT    = 20u;
const uint DIRECTION_SQRT  = 8u;
const float UNIFORM_PHASE  = 1.0 / (4.0 * ATMOSPHERE_PI);
const float MIN_HEIGHT     = 0.001;

void main()
{
    ivec2 size = imageSize(target);
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    vec2 uv = (vec2(id) + 0.5) / vec2(size);

    float mu_sun = uv.x * 2.0 - 1.0;
    float radius = params.bottom_radius + max(uv.y * (params.top_radius - params.bottom_radius), MIN_HEIGHT);

    vec3 origin        = vec3(0.0, radius, 0.0);
    vec3 sun_direction = vec3(sqrt(max(1.0 - mu_sun * mu_sun, 0.0)), mu_sun, 0.0);

    vec3 second_order    = vec3(0.0);
    vec3 transfer_factor = vec3(0.0);

    uint direction_count = DIRECTION_SQRT * DIRECTION_SQRT;

    for (uint i = 0u; i < direction_count; i++) {
        float u = (float(i % DIRECTION_SQRT) + 0.5) / float(DIRECTION_SQRT);
        float v = (float(i / DIRECTION_SQRT) + 0.5) / float(DIRECTION_SQRT);

        float cos_theta = 1.0 - 2.0 * u;
        float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
        float phi       = 2.0 * ATMOSPHERE_PI * v;

        vec3 direction = vec3(sin_theta * cos(phi), cos_theta, sin_theta * sin(phi));

        float bottom_t = ray_sphere_nearest(origin, direction, params.bottom_radius);
        float top_t    = ray_sphere_nearest(origin, direction, params.top_radius);

        float end_t = bottom_t >= 0.0 ? bottom_t : max(top_t, 0.0);
        float dt    = end_t / float(SAMPLE_COUNT);

        vec3 transmittance = vec3(1.0);
        vec3 luminance     = vec3(0.0);
        vec3 transfer      = vec3(0.0);

        for (uint s = 0u; s < SAMPLE_COUNT; s++) {
            vec3 position = origin + direction * ((float(s) + 0.5) * dt);

            medium_sample medium = sample_medium(params, position);

            vec3 step_transmittance = exp(-medium.extinction * dt);

            float sample_radius = length(position);
            float sample_mu     = dot(sun_direction, position / sample_radius);

            vec3 sun_transmittance = sample_transmittance(params, transmittance_lut, sample_radius, sample_mu);

            float planet_shadow = ray_sphere_nearest(position, sun_direction, params.bottom_radius) >= 0.0 ? 0.0 : 1.0;

            vec3 extinction = max(medium.extinction, vec3(ATMOSPHERE_MIN_EXTINCTION));

            vec3 scattered = planet_shadow * sun_transmittance * medium.scattering * UNIFORM_PHASE;

            luminance += transmittance * (scattered - scattered * step_transmittance) / extinction;
            transfer  += transmittance * (medium.scattering - medium.scattering * step_transmittance) / extinction;

            transmittance *= step_transmittance;
        }

        if (bottom_t >= 0.0) {
            vec3 position = origin + direction * bottom_t;
            vec3 up       = normalize(position);

            float ground_mu = dot(sun_direction, up);

            vec3 sun_transmittance = sample_transmittance(params, transmittance_lut, length(position), ground_mu);

            luminance += transmittance * sun_transmittance * max(ground_mu, 0.0) * params.ground_albedo / ATMOSPHERE_PI;
        }

        second_order    += luminance;
        transfer_factor += transfer;
    }

    second_order    /= float(direction_count);
    transfer_factor /= float(direction_count);

    vec3 multi_scattering = second_order / max(1.0 - transfer_factor, vec3(0.0001));

    imageStore(target, id, vec4(multi_scattering, 1.0));
}
