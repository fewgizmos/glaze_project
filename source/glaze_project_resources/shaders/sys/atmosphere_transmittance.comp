#version 450
#extension GL_EXT_buffer_reference : require

#include "sys/util/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;

layout(push_constant) uniform constants
{
    atmosphere_buffer atmosphere;
} pc;

const uint SAMPLE_COUNT = 40u;

void main()
{
    ivec2 size = imageSize(target);
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    atmosphere_params params = pc.atmosphere.params;

    float radius;
    float mu;

    transmittance_params(params, (vec2(id) + 0.5) / vec2(size), radius, mu);

    vec3 origin    = vec3(0.0, radius, 0.0);
    vec3 direction = vec3(sqrt(max(1.0 - mu * mu, 0.0)), mu, 0.0);

    float end_t = max(ray_sphere_nearest(origin, direction, params.top_radius), 0.0);
    float dt    = end_t / float(SAMPLE_COUNT);

    vec3 optical_depth = vec3(0.0);

    for (uint i = 0u; i < SAMPLE_COUNT; i++) {
        vec3 position = origin + direction * ((float(i) + 0.5) * dt);

        optical_depth += sample_medium(params, position).extinction * dt;
    }

    imageStore(target, id, vec4(exp(-optical_depth), 1.0));
}
