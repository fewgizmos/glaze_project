#version 450
#extension GL_EXT_buffer_reference : require

#include "head/ibl.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube source;

layout(buffer_reference, std430) writeonly buffer sh_buffer
{
    vec4 coefficients[9];
};

layout(push_constant) uniform constants
{
    sh_buffer output_buffer;
} pc;

const uint THREADS = 64u;

const float BAND_FACTORS[9] = float[](1.0, 2.0 / 3.0, 2.0 / 3.0, 2.0 / 3.0, 0.25, 0.25, 0.25, 0.25, 0.25);

shared vec3 partial[THREADS * 9u];

void sh_basis(vec3 d, out float basis[9])
{
    basis[0] = 0.282095;

    basis[1] = 0.488603 * d.y;
    basis[2] = 0.488603 * d.z;
    basis[3] = 0.488603 * d.x;

    basis[4] = 1.092548 * d.x * d.y;
    basis[5] = 1.092548 * d.y * d.z;
    basis[6] = 0.315392 * (3.0 * d.z * d.z - 1.0);
    basis[7] = 1.092548 * d.x * d.z;
    basis[8] = 0.546274 * (d.x * d.x - d.y * d.y);
}

void main()
{
    uint thread = gl_LocalInvocationID.x;

    int  size  = textureSize(source, 0).x;
    uint total = uint(size * size) * 6u;

    vec3 sums[9];

    for (uint i = 0u; i < 9u; i++) {
        sums[i] = vec3(0.0);
    }

    float basis[9];

    for (uint texel = thread; texel < total; texel += THREADS) {
        uint face  = texel / uint(size * size);
        uint local = texel % uint(size * size);

        vec2 uv = (vec2(local % uint(size), local / uint(size)) + 0.5) / float(size);
        vec2 st = uv * 2.0 - 1.0;

        vec3 direction = cube_direction(face, uv);

        float solid_angle = (4.0 / float(size * size)) / pow(1.0 + dot(st, st), 1.5);

        vec3 radiance = textureLod(source, direction, 0.0).rgb;

        sh_basis(direction, basis);

        for (uint i = 0u; i < 9u; i++) {
            sums[i] += radiance * basis[i] * solid_angle * BAND_FACTORS[i];
        }
    }

    for (uint i = 0u; i < 9u; i++) {
        partial[thread * 9u + i] = sums[i];
    }

    barrier();

    if (thread != 0u) {
        return;
    }

    for (uint i = 0u; i < 9u; i++) {
        vec3 total_sum = vec3(0.0);

        for (uint t = 0u; t < THREADS; t++) {
            total_sum += partial[t * 9u + i];
        }

        pc.output_buffer.coefficients[i] = vec4(total_sum, 0.0);
    }
}
