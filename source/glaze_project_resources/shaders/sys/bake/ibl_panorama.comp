#version 450

#include "head/ibl.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D panorama;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray target;

void main()
{
    ivec2 size = imageSize(target).xy;
    ivec3 id   = ivec3(gl_GlobalInvocationID);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec3 direction = cube_direction(uint(id.z), (vec2(id.xy) + 0.5) / vec2(size));

    vec2 uv = vec2(
        atan(direction.z, direction.x) / (2.0 * PI) + 0.5,
        acos(clamp(direction.y, -1.0, 1.0)) / PI
    );

    imageStore(target, id, vec4(textureLod(panorama, uv, 0.0).rgb, 1.0));
}
