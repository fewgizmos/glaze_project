#version 450

#include "sys/util/noise.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 7, rgba8) uniform writeonly image2D target;

const int COVERAGE_FREQUENCY = 4;
const int COVERAGE_OCTAVES   = 5;

const int CLUMP_FREQUENCY = 8;

const float COVERAGE_CENTER   = 0.6;
const float COVERAGE_CONTRAST = 3.0;

const int TYPE_FREQUENCY = 2;
const int TYPE_OCTAVES   = 3;

const int BASE_HEIGHT_FREQUENCY = 8;
const int BASE_HEIGHT_OCTAVES   = 3;

void main()
{
    ivec2 size = imageSize(target);
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(id, size))) {
        return;
    }

    vec3 uvw = vec3((vec2(id) + 0.5) / vec2(size), 0.5);

    float coverage = perlin_fbm(uvw, COVERAGE_FREQUENCY, COVERAGE_OCTAVES);
    float clumps   = worley_fbm(uvw, CLUMP_FREQUENCY);

    coverage = clamp(remap(coverage, 0.0, 1.0, clumps * 0.5, 1.0), 0.0, 1.0);
    coverage = clamp((coverage - COVERAGE_CENTER) * COVERAGE_CONTRAST + 0.5, 0.0, 1.0);

    float type = perlin_fbm(uvw + vec3(0.37, 0.71, 0.0), TYPE_FREQUENCY, TYPE_OCTAVES);

    float base_height = perlin_fbm(uvw + vec3(0.13, 0.29, 0.0), BASE_HEIGHT_FREQUENCY, BASE_HEIGHT_OCTAVES);

    imageStore(target, id, vec4(coverage, type, base_height, 1.0));
}
