#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D current_texture;
layout(set = 0, binding = 1) uniform sampler2D history_texture;
layout(set = 0, binding = 2) uniform sampler2D velocity_texture;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;
layout(set = 0, binding = 4) uniform sampler2D depth_texture;

layout(push_constant) uniform constants
{
    mat4 sky_reprojection;
    vec2 screen_size;
    float history_weight;
    uint reset;
} pc;

const vec3 LUMINANCE_WEIGHTS = vec3(0.2126, 0.7152, 0.0722);

const float NEIGHBOURHOOD_SIZE   = 9.0;
const float VARIANCE_GAMMA       = 1.25;
const float STATIC_HISTORY_BOOST = 0.05;
const float MAX_HISTORY_WEIGHT   = 0.97;
const float MOTION_FADE_PIXELS   = 2.0;
const float CLIP_EPSILON         = 0.0001;

vec3 sample_history_catmull_rom(vec2 uv)
{
    vec2 position = uv * pc.screen_size;
    vec2 center   = floor(position - 0.5) + 0.5;
    vec2 f        = position - center;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12      = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 texel = 1.0 / pc.screen_size;

    vec2 uv0  = (center - 1.0) * texel;
    vec2 uv3  = (center + 2.0) * texel;
    vec2 uv12 = (center + offset12) * texel;

    vec3 result = vec3(0.0);

    result += textureLod(history_texture, vec2(uv12.x, uv0.y), 0.0).rgb * w12.x * w0.y;
    result += textureLod(history_texture, vec2(uv0.x, uv12.y), 0.0).rgb * w0.x * w12.y;
    result += textureLod(history_texture, uv12, 0.0).rgb * w12.x * w12.y;
    result += textureLod(history_texture, vec2(uv3.x, uv12.y), 0.0).rgb * w3.x * w12.y;
    result += textureLod(history_texture, vec2(uv12.x, uv3.y), 0.0).rgb * w12.x * w3.y;

    float weight = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;

    return result / weight;
}

vec3 clip_towards_mean(vec3 history, vec3 mean, vec3 extent)
{
    vec3 offset = history - mean;

    vec3 units = abs(offset / max(extent, vec3(CLIP_EPSILON)));

    float largest = max(units.x, max(units.y, units.z));

    return largest > 1.0 ? mean + offset / largest : history;
}

vec3 rgb_to_ycocg(vec3 color)
{
    return vec3(
         0.25 * color.r + 0.5 * color.g + 0.25 * color.b,
         0.5  * color.r                 - 0.5  * color.b,
        -0.25 * color.r + 0.5 * color.g - 0.25 * color.b
    );
}

vec3 ycocg_to_rgb(vec3 color)
{
    return vec3(
        color.x + color.y - color.z,
        color.x           + color.z,
        color.x - color.y - color.z
    );
}

void main()
{
    ivec2 id   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.screen_size);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec3 current = texelFetch(current_texture, id, 0).rgb;

    vec2 uv         = (vec2(id) + 0.5) / pc.screen_size;
    vec2 history_uv = uv - texelFetch(velocity_texture, id, 0).xy;

    if (texelFetch(depth_texture, id, 0).r <= 0.0) {
        vec4 previous_clip = pc.sky_reprojection * vec4(uv * 2.0 - 1.0, 0.0, 1.0);

        history_uv = previous_clip.w > 0.0 ? previous_clip.xy / previous_clip.w * 0.5 + 0.5 : vec2(-1.0);
    }

    bool outside = any(lessThan(history_uv, vec2(0.0))) || any(greaterThan(history_uv, vec2(1.0)));

    if (pc.reset != 0u || pc.history_weight <= 0.0 || outside) {
        imageStore(target, id, vec4(current, 1.0));

        return;
    }

    vec3 moment1 = vec3(0.0);
    vec3 moment2 = vec3(0.0);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 coord = clamp(id + ivec2(x, y), ivec2(0), size - 1);

            vec3 neighbour = rgb_to_ycocg(texelFetch(current_texture, coord, 0).rgb);

            moment1 += neighbour;
            moment2 += neighbour * neighbour;
        }
    }

    moment1 /= NEIGHBOURHOOD_SIZE;
    moment2 /= NEIGHBOURHOOD_SIZE;

    vec3 deviation = sqrt(max(moment2 - moment1 * moment1, vec3(0.0)));

    vec3 history = max(sample_history_catmull_rom(history_uv), vec3(0.0));

    history = ycocg_to_rgb(clip_towards_mean(rgb_to_ycocg(history), moment1, deviation * VARIANCE_GAMMA));

    float motion_pixels = length((uv - history_uv) * pc.screen_size);

    float stillness = 1.0 - clamp(motion_pixels / MOTION_FADE_PIXELS, 0.0, 1.0);

    float blend_history = mix(pc.history_weight, min(pc.history_weight + STATIC_HISTORY_BOOST, MAX_HISTORY_WEIGHT), stillness);

    float current_luminance = dot(current, LUMINANCE_WEIGHTS);
    float history_luminance = dot(history, LUMINANCE_WEIGHTS);

    float flicker = abs(current_luminance - history_luminance) / max(max(current_luminance, history_luminance), CLIP_EPSILON);

    blend_history = mix(blend_history, MAX_HISTORY_WEIGHT, clamp(flicker, 0.0, 1.0) * stillness);

    float current_weight = (1.0 - blend_history) / (1.0 + dot(current, LUMINANCE_WEIGHTS));
    float history_weight = blend_history / (1.0 + dot(history, LUMINANCE_WEIGHTS));

    vec3 resolved = (current * current_weight + history * history_weight) / max(current_weight + history_weight, 0.0001);

    imageStore(target, id, vec4(max(resolved, vec3(0.0)), 1.0));
}
