#version 450

#include "util/ibl.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray target;

const float SAMPLE_DELTA = 0.025;
const float SOURCE_LOD   = 3.0;

void main()
{
    ivec2 size = imageSize(target).xy;
    ivec3 id   = ivec3(gl_GlobalInvocationID);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec3 normal = cube_direction(uint(id.z), (vec2(id.xy) + 0.5) / vec2(size));

    vec3 up    = abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
    vec3 right = normalize(cross(up, normal));

    up = cross(normal, right);

    vec3  sum   = vec3(0.0);
    float count = 0.0;

    for (float phi = 0.0; phi < 2.0 * PI; phi += SAMPLE_DELTA) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += SAMPLE_DELTA) {
            vec3 tangent_sample = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));

            vec3 direction = tangent_sample.x * right + tangent_sample.y * up + tangent_sample.z * normal;

            sum   += textureLod(source, direction, SOURCE_LOD).rgb * cos(theta) * sin(theta);
            count += 1.0;
        }
    }

    imageStore(target, id, vec4(PI * sum / count, 1.0));
}
