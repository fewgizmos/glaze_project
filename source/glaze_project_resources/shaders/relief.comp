#version 450
#extension GL_EXT_buffer_reference : require

#include "util/scene.glsl"

layout(local_size_x = 64) in;

const uint  OCTAVES   = 5u;
const float FREQUENCY = 2.0;
const float AMPLITUDE = 0.15;

const float NORMAL_STEP = 0.01;

float hash(vec3 p)
{
    p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
    p *= 17.0;

    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float value_noise(vec3 p)
{
    vec3 cell  = floor(p);
    vec3 local = fract(p);

    local = local * local * (3.0 - 2.0 * local);

    float x00 = mix(hash(cell + vec3(0.0, 0.0, 0.0)), hash(cell + vec3(1.0, 0.0, 0.0)), local.x);
    float x10 = mix(hash(cell + vec3(0.0, 1.0, 0.0)), hash(cell + vec3(1.0, 1.0, 0.0)), local.x);
    float x01 = mix(hash(cell + vec3(0.0, 0.0, 1.0)), hash(cell + vec3(1.0, 0.0, 1.0)), local.x);
    float x11 = mix(hash(cell + vec3(0.0, 1.0, 1.0)), hash(cell + vec3(1.0, 1.0, 1.0)), local.x);

    return mix(mix(x00, x10, local.y), mix(x01, x11, local.y), local.z);
}

float relief_at(vec3 dir)
{
    float height = 0.0;
    float weight = 0.5;

    vec3 p = dir * FREQUENCY;

    for (uint i = 0u; i < OCTAVES; i++) {
        height += value_noise(p) * weight;

        p      *= 2.0;
        weight *= 0.5;
    }

    return (height - 0.5) * 2.0 * AMPLITUDE;
}

vec3 surface_at(vec3 dir, float radius)
{
    return dir * (radius + relief_at(dir));
}

void main()
{
    object_data object = pc.frame.objects.data[gl_GlobalInvocationID.y];

    uint i = gl_GlobalInvocationID.x;

    if (i >= object.vertex_count) {
        return;
    }

    vertex v = object.vertices.data[i];

    if (v.color.a < 0.5) {
        return;
    }

    float radius = length(v.pos);

    vec3 dir = v.pos / radius;

    vec3 up = abs(dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);

    vec3 side    = normalize(cross(up, dir));
    vec3 forward = cross(dir, side);

    vec3 pos         = surface_at(dir, radius);
    vec3 pos_side    = surface_at(normalize(dir + side * NORMAL_STEP), radius);
    vec3 pos_forward = surface_at(normalize(dir + forward * NORMAL_STEP), radius);

    vec3 normal = normalize(cross(pos_side - pos, pos_forward - pos));

    if (dot(normal, dir) < 0.0) {
        normal = -normal;
    }

    v.pos    = pos;
    v.normal = normal;

    v.tangent.xyz = normalize(v.tangent.xyz - normal * dot(normal, v.tangent.xyz));

    v.color.a = 0.0;

    object.vertices.data[i] = v;
}
