#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 6) in;

struct face
{
    vec4 color;
    uvec4 rng;
};

layout(buffer_reference, std430) buffer face_buffer
{
    face data[];
};

layout(push_constant) uniform constants
{
    face_buffer faces;
    uint count;
} pc;

uint next(inout uint state)
{
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;

    return state;
}

float next_float(inout uint state)
{
    return float(next(state) >> 8) / 16777216.0;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.count) {
        return;
    }

    uint state = pc.faces.data[i].rng.x;

    pc.faces.data[i].color = vec4(next_float(state), next_float(state), next_float(state), 1.0);
    pc.faces.data[i].rng.x = state;
}
