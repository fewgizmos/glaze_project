#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 6) in;

struct face
{
    vec4 color;
    uvec4 rng;
};

layout(buffer_reference, std430) buffer face_buffer
{
    face data[];
};

layout(push_constant) uniform constants
{
    face_buffer faces;
    uint count;
} pc;

const float STEP = 0.004;

uint next(inout uint state)
{
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;

    return state;
}

float next_sign(inout uint state)
{
    return (next(state) & 1u) == 0u ? -STEP : STEP;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= pc.count) {
        return;
    }

    uint state = pc.faces.data[i].rng.x;

    vec3 color = pc.faces.data[i].color.rgb;

    color += vec3(next_sign(state), next_sign(state), next_sign(state));

    pc.faces.data[i].color = vec4(clamp(color, 0.0, 1.0), 1.0);
    pc.faces.data[i].rng.x = state;
}
