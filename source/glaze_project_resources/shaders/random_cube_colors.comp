#version 450

layout (local_size_x = 6) in;

struct face
{
    vec4 color;
    uvec4 rng;
};

layout (std430, set = 0, binding = 1) buffer face_buffer
{
    face faces[];
};

uint next (inout uint state)
{
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;

    return state;
}

float next_float (inout uint state)
{
    return float (next (state) >> 8) / 16777216.0;
}

void main ()
{
    uint i = gl_GlobalInvocationID.x;

    if (i >= faces.length ()) {
        return;
    }

    uint state = faces[i].rng.x;

    faces[i].color = vec4 (next_float (state), next_float (state), next_float (state), 1.0);
    faces[i].rng.x = state;
}
